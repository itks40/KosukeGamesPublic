{
  "name": "tft-worker",
  "private": true,
  "version": "0.1.0",
  "description": "TFTオンライン対戦のCloudflare Worker（API・Durable Object）。静的サイト側（tft/, js/）とは独立したビルド対象。",
  "type": "module",
  "scripts": {
    "build:logic": "node scripts/build-game-logic.mjs",
    "predev": "npm run build:logic",
    "dev": "wrangler dev",
    "predeploy": "npm run build:logic",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute tft-online --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute tft-online --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
